      "stem": "This question investigates convergence of improper integrals. Unless another restriction is given, $n>1$ and all logarithms are natural. An improper integral is interpreted as a limit of finite integrals, not by substituting infinity into an antiderivative.",
      "parts": [
        {
          "label": "a(i)",
          "prompt": "Use your calculator to evaluate $\\displaystyle\\int_1^{100}\\frac{dx}{x}$ and $\\displaystyle\\int_1^{1000}\\frac{dx}{x}$ to three significant figures.",
          "marks": 1
        },
        {
          "label": "a(ii)",
          "prompt": "Evaluate $\\displaystyle\\int_1^{100}x^{-2}\\,dx$ and $\\displaystyle\\int_1^{1000}x^{-2}\\,dx$.",
          "marks": 1
        },
        {
          "label": "b(i)",
          "prompt": "Show that $\\displaystyle\\int_1^n x^{-3}\\,dx=\\frac{n^2-1}{2n^2}$.",
          "marks": 2
        },
        {
          "label": "b(ii)",
          "prompt": "Hence evaluate $\\displaystyle\\int_1^\\infty x^{-3}\\,dx$, explaining the limiting step.",
          "marks": 2
        },
        {
          "label": "c(i)",
          "prompt": "Find $\\displaystyle\\int_1^n x^{-1/2}\\,dx$ in terms of $n$.",
          "marks": 3
        },
        {
          "label": "c(ii)",
          "prompt": "Determine whether $\\displaystyle\\int_1^\\infty x^{-1/2}\\,dx$ converges.",
          "marks": 1
        },
        {
          "label": "d(i)",
          "prompt": "For a real parameter $p\\ne0$, find $\\displaystyle\\int_1^n x^{-(p+1)}\\,dx$.",
          "marks": 3
        },
        {
          "label": "d(ii)",
          "prompt": "For $p>0$, find $\\displaystyle\\int_1^\\infty x^{-(p+1)}\\,dx$ and justify convergence.",
          "marks": 2
        },
        {
          "label": "d(iii)",
          "prompt": "State what happens to this improper integral when $p<0$.",
          "marks": 1
        },
        {
          "label": "d(iv)",
          "prompt": "Evaluate $\\displaystyle\\int_1^\\infty x^{-2025}\\,dx$.",
          "marks": 1
        },
        {
          "label": "e(i)",
          "prompt": "For $x>1$, differentiate $y=\\ln(\\ln x)$.",
          "marks": 1
        },
        {
          "label": "e(ii)",
          "prompt": "For $n>2$, evaluate $\\displaystyle\\int_2^n\\frac{dx}{x\\ln x}$.",
          "marks": 2
        },
        {
          "label": "e(iii)",
          "prompt": "Determine whether $\\displaystyle\\int_2^\\infty\\frac{dx}{x\\ln x}$ converges.",
          "marks": 1
        },
        {
          "label": "f(i)",
          "prompt": "For $x>1$ and $p\\ne0$, use $u=\\ln x$ to find $\\displaystyle\\int\\frac{dx}{x(\\ln x)^{p+1}}$.",
          "marks": 3
        },
        {
          "label": "f(ii)",
          "prompt": "For $n>2$, evaluate $\\displaystyle\\int_2^n\\frac{dx}{x(\\ln x)^{p+1}}$.",
          "marks": 1
        },
        {
          "label": "f(iii)",
          "prompt": "For $p>0$, evaluate the corresponding improper integral from $2$ to infinity.",
          "marks": 1
        },
        {
          "label": "f(iv)",
          "prompt": "State what happens when $p<0$.",
          "marks": 1
        },
        {
          "label": "g(i)",
          "prompt": "For $p>0$, find $\\displaystyle\\int e^{-px}\\,dx$.",
          "marks": 1
        },
        {
          "label": "g(ii)",
          "prompt": "Evaluate $\\displaystyle\\int_0^n e^{-px}\\,dx$.",
          "marks": 1
        },
        {
          "label": "g(iii)",
          "prompt": "Hence evaluate $\\displaystyle\\int_0^\\infty e^{-px}\\,dx$.",
          "marks": 1
        }
      ],
      "markScheme": [
        {
          "part": "a(i)",
          "steps": [
            {
              "code": "A1",
              "text": "The values are$\\ln100\\approx4.61$and$\\ln1000\\approx6.91$."
            }
          ]
        },
        {
          "part": "a(ii)",
          "steps": [
            {
              "code": "A1",
              "text": "The values are$0.990$and$0.999$."
            }
          ]
        },
        {
          "part": "b(i)",
          "steps": [
            {
              "code": "A1",
              "text": "The antiderivative is$-1/(2x^2)$."
            },
            {
              "code": "A1",
              "text": "The definite integral is$1/2-1/(2n^2)=(n^2-1)/(2n^2)$."
            }
          ]
        },
        {
          "part": "b(ii)",
          "steps": [
            {
              "code": "A1",
              "text": "$1/(2n^2)\\to0$as$n\\to\\infty$."
            },
            {
              "code": "A1",
              "text": "The improper integral converges to$1/2$."
            }
          ]
        },
        {
          "part": "c(i)",
          "steps": [
            {
              "code": "M1",
              "text": "Use the power rule with exponent$-1/2$."
            },
            {
              "code": "A1",
              "text": "The antiderivative is$2\\sqrt{x}$."
            },
            {
              "code": "A1",
              "text": "The value is$2\\sqrt n-2$."
            }
          ]
        },
        {
          "part": "c(ii)",
          "steps": [
            {
              "code": "A1",
              "text": "$2\\sqrt n-2\\to+\\infty$, so the integral diverges."
            }
          ]
        },
        {
          "part": "d(i)",
          "steps": [
            {
              "code": "M1",
              "text": "Integrate$x^{-p-1}$using the power rule."
            },
            {
              "code": "A1",
              "text": "The antiderivative is$-x^{-p}/p$."
            },
            {
              "code": "A1",
              "text": "The definite integral is$(1-n^{-p})/p$."
            }
          ]
        },
        {
          "part": "d(ii)",
          "steps": [
            {
              "code": "M1",
              "text": "$n^{-p}\\to0$for$p>0$."
            },
            {
              "code": "A1",
              "text": "The value is$1/p$."
            }
          ]
        },
        {
          "part": "d(iii)",
          "steps": [
            {
              "code": "A1",
              "text": "For$p<0$, $(1-n^{-p})/p\\to+\\infty$, so it diverges."
            }
          ]
        },
        {
          "part": "d(iv)",
          "steps": [
            {
              "code": "A1",
              "text": "$p=2024$, so the result is$1/2024$."
            }
          ]
        },
        {
          "part": "e(i)",
          "steps": [
            {
              "code": "A1",
              "text": "$dy/dx=1/(x\\ln x)$."
            }
          ]
        },
        {
          "part": "e(ii)",
          "steps": [
            {
              "code": "M1",
              "text": "Use$\\ln(\\ln x)$as an antiderivative."
            },
            {
              "code": "A1",
              "text": "The result is$\\ln(\\ln n)-\\ln(\\ln2)$."
            }
          ]
        },
        {
          "part": "e(iii)",
          "steps": [
            {
              "code": "A1",
              "text": "$\\ln(\\ln n)\\to+\\infty$, so the integral diverges."
            }
          ]
        },
        {
          "part": "f(i)",
          "steps": [
            {
              "code": "M1",
              "text": "$u=\\ln x$gives$du=dx/x$."
            },
            {
              "code": "A1",
              "text": "The integral becomes$\\int u^{-p-1}du=-u^{-p}/p+C$."
            },
            {
              "code": "A1",
              "text": "The result is$-1/[p(\\ln x)^p]+C$."
            }
          ]
        },
        {
          "part": "f(ii)",
          "steps": [
            {
              "code": "A1",
              "text": "$1/[p(\\ln2)^p]-1/[p(\\ln n)^p]$."
            }
          ]
        },
        {
          "part": "f(iii)",
          "steps": [
            {
              "code": "A1",
              "text": "The term$(\\ln n)^{-p}$tends to zero, giving$1/[p(\\ln2)^p]$."
            }
          ]
        },
        {
          "part": "f(iv)",
          "steps": [
            {
              "code": "A1",
              "text": "The integral diverges to$+\\infty$."
            }
          ]
        },
        {
          "part": "g(i)",
          "steps": [
            {
              "code": "A1",
              "text": "$-e^{-px}/p+C$."
            }
          ]
        },
        {
          "part": "g(ii)",
          "steps": [
            {
              "code": "A1",
              "text": "$(1-e^{-pn})/p$."
            }
          ]
        },
        {
          "part": "g(iii)",
          "steps": [
            {
              "code": "A1",
              "text": "$e^{-pn}\\to0$and the integral equals$1/p$."
            }
          ]
        }
