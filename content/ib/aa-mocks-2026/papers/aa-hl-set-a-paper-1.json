    {
      "number": 10,
      "section": "B",
      "marks": 18,
      "stem": "The continuous random variable $X$ has probability density $f(x)=\\dfrac{k}{1+x^2}$ for $0\\le x\\le1$, and $f(x)=0$ otherwise, where $k>0$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find the exact value of $k$.",
          "marks": 3
        },
        {
          "label": "b",
          "prompt": "Write down $\\mathrm P(X=1/\\sqrt3)$.",
          "marks": 1
        },
        {
          "label": "c",
          "prompt": "Find the exact value of $\\mathrm P(X\\le1/\\sqrt3)$.",
          "marks": 2
        },
        {
          "label": "d",
          "prompt": "Show that $\\mathrm E(X)=\\dfrac{\\ln b}{\\pi}$ and find $b$.",
          "marks": 4
        },
        {
          "label": "e",
          "prompt": "Find the exact value of $\\mathrm E(X^2)$.",
          "marks": 5
        },
        {
          "label": "f",
          "prompt": "The median is $M=\\tan\\theta$, where $0<\\theta<\\pi/2$. Find the exact value of $\\theta$.",
          "marks": 3
        }
      ],
      "answerSummary": "$k=4/\\pi$; probability $0$, CDF $2/3$; $b=4$; $\\mathrm E(X^2)=4/\\pi-1$; $\\theta=\\pi/8$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "$\\int_0^1 k/(1+x^2)\\,\\mathrm dx=1$."
            },
            {
              "code": "A1",
              "text": "$k[\\arctan x]_0^1=k\\pi/4=1$."
            },
            {
              "code": "A1",
              "text": "$k=4/\\pi$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "A1",
              "text": "$0$, because $X$ is continuous."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "M1",
              "text": "$\\frac4\\pi[\\arctan x]_0^{1/\\sqrt3}$."
            },
            {
              "code": "A1",
              "text": "$\\frac4\\pi\\cdot\\frac\\pi6=2/3$."
            }
          ]
        },
        {
          "part": "d",
          "steps": [
            {
              "code": "M1",
              "text": "$\\mathrm E(X)=\\frac4\\pi\\int_0^1x/(1+x^2)\\,\\mathrm dx$."
            },
            {
              "code": "A1",
              "text": "$=\\frac2\\pi[\\ln(1+x^2)]_0^1$."
            },
            {
              "code": "A1",
              "text": "$=2\\ln2/\\pi$."
            },
            {
              "code": "A1",
              "text": "$=\\ln4/\\pi$, so $b=4$."
            }
          ]
        },
        {
          "part": "e",
          "steps": [
            {
              "code": "M1",
              "text": "$\\mathrm E(X^2)=\\frac4\\pi\\int_0^1x^2/(1+x^2)\\,\\mathrm dx$."
            },
            {
              "code": "M1",
              "text": "Write $x^2=(1+x^2)-1$."
            },
            {
              "code": "A1",
              "text": "The integrand becomes $1-1/(1+x^2)$."
            },
            {
              "code": "A1",
              "text": "$\\frac4\\pi[x-\\arctan x]_0^1$."
            },
            {
              "code": "A1",
              "text": "$4/\\pi-1$."
            }
          ]
        },
        {
          "part": "f",
          "steps": [
            {
              "code": "M1",
              "text": "$\\frac4\\pi\\int_0^M1/(1+x^2)\\,\\mathrm dx=1/2$."
            },
            {
              "code": "A1",
              "text": "$\\frac4\\pi\\arctan M=1/2$."
            },
            {
              "code": "A1",
              "text": "$\\theta=\\pi/8$."
            }
          ]
        }
      ],
      "sourcePages": [
