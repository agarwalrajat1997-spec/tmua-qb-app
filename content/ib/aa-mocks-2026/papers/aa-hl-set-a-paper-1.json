    {
      "number": 8,
      "section": "A",
      "marks": 6,
      "stem": "Non-zero vectors $\\mathbf a$ and $\\mathbf b$ are perpendicular.",
      "parts": [
        {
          "label": "",
          "prompt": "Prove that $3\\mathbf a-\\mathbf b$ is perpendicular to $\\mathbf a+3\\mathbf b$ if and only if $|\\mathbf a|=|\\mathbf b|$.",
          "marks": 6
        }
      ],
      "answerSummary": "Both directions follow from dot product $3(|\\mathbf a|^2-|\\mathbf b|^2)$.",
      "markScheme": [
        {
          "part": "",
          "steps": [
            {
              "code": "A1",
              "text": "$\\mathbf a\\cdot\\mathbf b=0$."
            },
            {
              "code": "M1",
              "text": "Expand $(3\\mathbf a-\\mathbf b)\\cdot(\\mathbf a+3\\mathbf b)=3|\\mathbf a|^2-3|\\mathbf b|^2$."
            },
            {
              "code": "A1",
              "text": "Perpendicularity is equivalent to $|\\mathbf a|^2=|\\mathbf b|^2$."
            },
            {
              "code": "M1",
              "text": "Magnitudes are nonnegative, so equality of squares is equivalent to equality of magnitudes."
            },
            {
              "code": "A1",
              "text": "Hence $|\\mathbf a|=|\\mathbf b|$."
            },
            {
              "code": "M1",
              "text": "Explicit equivalences, or the reverse implication as well as the forward one, complete the if-and-only-if proof."
            }
          ]
        }
      ],
      "sourcePages": [
        9
      ]
    },
    {
      "number": 9,
      "section": "A",
      "marks": 9,
      "stem": "The ellipse $C$ has equation $4x^2+y^2=4$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find the equation of the tangent to $C$ at the point where $y=2$.",
          "marks": 4
        },
        {
          "label": "b",
          "prompt": "The line $x\\cos\\theta+y\\sin\\theta=\\sqrt2$ is tangent to $C$, where $0<\\theta<\\pi/2$. Show that $\\sin^2\\theta=\\frac13$.",
          "marks": 5
        }
      ],
      "answerSummary": "Tangent $y=2$; $\\sin^2\\theta=1/3$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$x=0$ when $y=2$."
            },
            {
              "code": "A1",
              "text": "Implicit differentiation gives $8x+2y\\,\\mathrm dy/\\mathrm dx=0$, so $\\mathrm dy/\\mathrm dx=-4x/y$."
            },
            {
              "code": "A1",
              "text": "The tangent has gradient $0$."
            },
            {
              "code": "A1",
              "text": "The tangent is $y=2$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "Substitute $y=\\sqrt2\\csc\\theta-x\\cot\\theta$ into the ellipse."
            },
            {
              "code": "A1",
              "text": "$(4+\\cot^2\\theta)x^2-2\\sqrt2\\csc\\theta\\cot\\theta\\,x+2\\csc^2\\theta-4=0$."
            },
            {
              "code": "M1",
              "text": "Tangency requires discriminant $0$."
            },
            {
              "code": "A1",
              "text": "Simplification gives $2\\csc^2\\theta=4+\\cot^2\\theta$."
            },
            {
              "code": "A1",
              "text": "Using $\\cot^2\\theta=\\csc^2\\theta-1$ gives $\\csc^2\\theta=3$, hence $\\sin^2\\theta=1/3$."
            }
          ]
        }
      ],
      "sourcePages": [
