      "answerSummary": "$y=x/5+1$; $m=e/5$; $S=(10-a)e^{a/5}$; maximum at $a=5$, $P=10+2e$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "$f\\prime(x)=e^{x/5}/5$."
            },
            {
              "code": "A1",
              "text": "At $x=0$, the point is $(0,1)$ and gradient is $1/5$."
            },
