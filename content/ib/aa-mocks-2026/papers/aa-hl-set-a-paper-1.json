          "label": "",
          "prompt": "Solve $3\\log_8(x+2)-2\\log_2(x+1)=1$, giving an exact answer.",
          "marks": 6
        }
      ],
      "answerSummary": "$x=0$.",
      "markScheme": [
        {
          "part": "",
          "steps": [
            {
              "code": "M1",
              "text": "Change base: $\\log_8(x+2)=\\log_2(x+2)/3$."
            },
            {
              "code": "A1",
              "text": "$\\log_2(x+2)-2\\log_2(x+1)=1$."
            },
            {
              "code": "M1",
              "text": "$\\log_2((x+2)/(x+1)^2)=1$."
            },
            {
              "code": "A1",
              "text": "$x+2=2(x+1)^2$."
            },
            {
              "code": "A1",
              "text": "$x(2x+3)=0$, so $x=0$ or $x=-3/2$."
            },
            {
              "code": "A1",
              "text": "The logarithms require $x>-1$, so only $x=0$ is valid."
            }
          ]
        }
      ],
