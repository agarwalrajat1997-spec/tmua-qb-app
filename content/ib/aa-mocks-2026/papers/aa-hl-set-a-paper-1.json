          "marks": 3
        },
        {
          "label": "b",
          "prompt": "The line $y=mx$ is tangent to $y=f(x)$. Find $m$.",
          "marks": 5
        },
        {
          "label": "c",
          "prompt": "Express $S$ in terms of $a$.",
