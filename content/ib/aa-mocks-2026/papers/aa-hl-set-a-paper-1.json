            {
              "code": "A1",
              "text": "$S\\prime=-e^{a/5}+(10-a)e^{a/5}/5$."
            },
            {
              "code": "A1",
              "text": "$S\\prime=(1-a/5)e^{a/5}$."
            }
          ]
        },
