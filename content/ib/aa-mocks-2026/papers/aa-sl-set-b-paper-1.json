    {
      "number": 8,
      "section": "B",
      "marks": 15,
      "stem": "In triangle $ABC$, $\\angle CAB=x$ and $\\angle ABC=2x$, with $0^\\circ<x<90^\\circ$ and $\\sin x=3/5$. Side $BC=25$cm. Point $D$ is the foot of the perpendicular from $C$ to $AB$ and lies between $A$ and $B$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find the exact values of $\\cos x$ and $\\sin2x$.",
          "marks": 4
        },
        {
          "label": "b",
          "prompt": "Find the exact value of $\\cos2x$.",
          "marks": 3
        },
        {
          "label": "c",
          "prompt": "Find $AC$.",
          "marks": 3
        },
        {
          "label": "d",
          "prompt": "Find $BD$.",
          "marks": 2
        },
        {
          "label": "e",
          "prompt": "Find the area of triangle $ABC$.",
          "marks": 3
        }
      ],
      "answerSummary": "$\\cos x=4/5$, $\\sin2x=24/25$, $\\cos2x=7/25$, $AC=40$, $BD=7$, area 468.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "Use $\\cos^2x=1-\\sin^2x$ and the first-quadrant condition."
            },
            {
              "code": "A2",
              "text": "$\\cos x=4/5$."
            },
            {
              "code": "A1",
              "text": "$\\sin2x=2(3/5)(4/5)=24/25$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "Use $\\cos2x=1-2\\sin^2x$."
            },
            {
              "code": "A1",
              "text": "$1-2(3/5)^2=1-18/25$."
            },
            {
              "code": "A1",
              "text": "$\\cos2x=7/25$."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "M1",
              "text": "Use the sine rule: $25/\\sin x=AC/\\sin2x$."
            },
            {
              "code": "A1",
              "text": "$AC=25(24/25)/(3/5)$."
            },
            {
              "code": "A1",
              "text": "$AC=40$cm."
            }
          ]
        },
        {
          "part": "d",
          "steps": [
            {
              "code": "M1",
              "text": "$\\cos2x=BD/25$."
            },
            {
              "code": "A1",
              "text": "$BD=7$cm."
            }
          ]
        },
        {
          "part": "e",
          "steps": [
            {
              "code": "A1",
              "text": "$AD=40\\cos x=32$, so $AB=32+7=39$."
            },
            {
              "code": "M1",
              "text": "Area $=\\frac12 AC\\cdot AB\\sin x$."
            },
            {
              "code": "A1",
              "text": "The area is 468$\\,\\mathrm{cm}^2$."
            }
          ]
        }
      ],
