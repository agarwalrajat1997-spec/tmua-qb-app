  "questions": [
    {
      "number": 1,
      "section": "A",
      "marks": 5,
      "stem": "Let $f(x)=2x-1$ and $g(x)=3x$, for $x\\in\\mathbb{R}$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $(f\\circ g)(x)$.",
          "marks": 1
        },
        {
          "label": "b",
          "prompt": "Find $(g\\circ f)(x)$ and hence simplify $(f\\circ g)(x)-(g\\circ f)(x)$.",
          "marks": 2
        },
        {
          "label": "c",
          "prompt": "Find $f^{-1}(x)$.",
          "marks": 2
        }
      ],
      "answerSummary": "$6x-1$; $6x-3$, difference 2; $f^{-1}(x)=(x+1)/2$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$(f\\circ g)(x)=6x-1$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "A1",
              "text": "$(g\\circ f)(x)=6x-3$."
            },
            {
              "code": "A1",
              "text": "The difference is 2."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "M1",
              "text": "$y=2x-1\\implies x=(y+1)/2$."
            },
            {
              "code": "A1",
              "text": "$f^{-1}(x)=(x+1)/2$."
            }
          ]
        }
      ],
      "sourcePages": [
        2
      ]
    },
    {
      "number": 2,
      "section": "A",
      "marks": 6,
      "stem": "In triangle $ABC$, $AB=2$cm, $AC=3$cm and $BC=\\sqrt7$cm.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $\\angle BAC$ exactly.",
          "marks": 4
        },
        {
          "label": "b",
          "prompt": "Find the exact area of the triangle.",
          "marks": 2
        }
      ],
      "answerSummary": "$\\angle BAC=60^\\circ$ and area $3\\sqrt3/2\\,\\mathrm{cm}^2$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "Use the cosine rule with side $BC$ opposite $\\angle BAC$."
            },
            {
              "code": "A1",
              "text": "$7=2^2+3^2-2\\cdot2\\cdot3\\cos\\angle BAC$."
            },
            {
              "code": "A1",
              "text": "$\\cos\\angle BAC=1/2$."
            },
            {
              "code": "A1",
              "text": "$\\angle BAC=60^\\circ$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "Use $\\frac12 AB\\cdot AC\\sin\\angle BAC$."
            },
            {
              "code": "A1",
              "text": "The area is $3\\sqrt3/2\\,\\mathrm{cm}^2$."
            }
          ]
        }
      ],
      "sourcePages": [
        3
      ],
      "diagramSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 480\" role=\"img\" aria-label=\"Triangle ABC; side lengths in centimetres\"><rect width=\"820\" height=\"480\" fill=\"white\"/><text x=\"410\" y=\"27\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"20\" fill=\"#111\">Triangle ABC; side lengths in centimetres</text><polyline points=\"260.000,80.000 150.000,380.000 600.000,380.000 260.000,80.000\" fill=\"none\" stroke=\"#111\" stroke-width=\"2.2\"/><text x=\"260\" y=\"60\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"18\" fill=\"#111\">A</text><text x=\"140\" y=\"410\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"18\" fill=\"#111\">B</text><text x=\"610\" y=\"410\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"18\" fill=\"#111\">C</text><text x=\"180\" y=\"220\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"18\" fill=\"#111\">2</text><text x=\"455\" y=\"215\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"18\" fill=\"#111\">3</text><text x=\"370\" y=\"415\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"18\" fill=\"#111\">√7</text></svg>"
