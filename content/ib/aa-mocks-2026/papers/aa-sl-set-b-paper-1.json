    {
      "number": 10,
      "section": "B",
      "marks": 13,
      "stem": "Let $F(u)=(2u-1)(u-1)(u+3)$. All requested solutions are real.",
      "parts": [
        {
          "label": "a",
          "prompt": "Solve $F(u)=0$.",
          "marks": 2
        },
        {
          "label": "b",
          "prompt": "Expand $F(u)$ to show that $F(u)=2u^3+3u^2-8u+3$.",
          "marks": 1
        },
        {
          "label": "c",
          "prompt": "Hence solve $2(\\ln x)^3+3(\\ln x)^2-8\\ln x+3=0$.",
          "marks": 3
        },
        {
          "label": "d",
          "prompt": "Solve $2e^{3x}+3e^{2x}-8e^x+3=0$.",
          "marks": 3
        },
        {
          "label": "e",
          "prompt": "Solve $8\\sin x-3\\sin^2x-2\\sin^3x=3$ for $0\\le x\\le2\\pi$.",
          "marks": 4
        }
      ],
      "answerSummary": "$u=1/2,1,-3$; logarithmic roots $\\sqrt e,e,e^{-3}$; exponential roots $\\ln(1/2),0$; trig roots $\\pi/6,\\pi/2,5\\pi/6$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$u=1/2$ or $u=1$."
            },
            {
              "code": "A1",
              "text": "$u=-3$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "A1",
              "text": "Expansion gives $2u^3+3u^2-8u+3$."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "A1",
              "text": "$\\ln x=1/2\\implies x=\\sqrt e$."
            },
            {
              "code": "A1",
              "text": "$\\ln x=1\\implies x=e$."
            },
            {
              "code": "A1",
              "text": "$\\ln x=-3\\implies x=e^{-3}$."
            }
          ]
        },
        {
          "part": "d",
          "steps": [
            {
              "code": "A1",
              "text": "$e^x=1/2\\implies x=\\ln(1/2)$."
            },
            {
              "code": "A1",
              "text": "$e^x=1\\implies x=0$."
            },
            {
              "code": "A1",
              "text": "$e^x=-3$ is impossible and is rejected."
            }
          ]
        },
        {
          "part": "e",
          "steps": [
            {
              "code": "A1",
              "text": "$\\sin x=1/2\\implies x=\\pi/6$."
            },
            {
              "code": "A1",
              "text": "Also $x=5\\pi/6$."
            },
            {
              "code": "A1",
              "text": "$\\sin x=1\\implies x=\\pi/2$."
            },
            {
              "code": "A1",
              "text": "$\\sin x=-3$ is impossible; there are no further solutions."
            }
          ]
        }
      ],
