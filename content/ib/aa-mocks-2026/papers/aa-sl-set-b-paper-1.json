    {
      "number": 7,
      "section": "A",
      "marks": 6,
      "stem": "The diagram shows a differentiable function $f$, with stationary points $A(2,3)$ and $B(0,-4)$. Let $g(x)=x^2+1$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $(f\\circ g)(1)$ and $(g\\circ f)(0)$.",
          "marks": 2
        },
        {
          "label": "b",
          "prompt": "Find the gradient of the normal to $y=f(x)/g(x)$ at $x=2$.",
          "marks": 4
        }
      ],
      "answerSummary": "$3$ and $17$; normal gradient $25/12$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$g(1)=2$, so $(f\\circ g)(1)=f(2)=3$."
            },
            {
              "code": "A1",
              "text": "$(g\\circ f)(0)=g(-4)=17$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "Use the quotient rule $y\\,\\!\\prime=(f\\,\\!\\prime g-fg\\,\\!\\prime)/g^2$."
            },
            {
              "code": "A1",
              "text": "$g\\,\\!\\prime(x)=2x$, and $f\\,\\!\\prime(2)=0$ because $A$ is stationary."
            },
            {
              "code": "A1",
              "text": "$y\\,\\!\\prime(2)=[0\\cdot5-3\\cdot4]/25=-12/25$."
            },
            {
              "code": "A1",
              "text": "The normal gradient is $25/12$."
            }
          ]
        }
      ],
