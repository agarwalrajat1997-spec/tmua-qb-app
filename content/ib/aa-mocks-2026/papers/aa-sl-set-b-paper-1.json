    {
      "number": 5,
      "section": "A",
      "marks": 6,
      "stem": "Consider the following integrals.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $\\displaystyle\\int\\frac{12x^3}{x^4+1}\\,\\mathrm{d}x$.",
          "marks": 4
        },
        {
          "label": "b",
          "prompt": "Given $\\displaystyle\\int_0^1\\frac{12x^3}{x^4+1}\\,\\mathrm{d}x=\\ln A$, find $A$.",
          "marks": 2
        }
      ],
      "answerSummary": "Antiderivative $3\\ln(x^4+1)+C$ and $A=8$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "Let $u=x^4+1$."
            },
            {
              "code": "A1",
              "text": "$\\mathrm{d}u=4x^3\\,\\mathrm{d}x$."
            },
            {
              "code": "A1",
              "text": "The integral becomes $3\\int u^{-1}\\,\\mathrm{d}u$."
            },
            {
              "code": "A1",
              "text": "$3\\ln(x^4+1)+C$; $x^4+1$ is always positive."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "The definite integral is $3\\ln2-3\\ln1=3\\ln2$."
            },
            {
              "code": "A1",
              "text": "$A=8$."
            }
          ]
        }
      ],
      "sourcePages": [
        6
      ]
    },
    {
      "number": 6,
      "section": "A",
      "marks": 6,
      "stem": "Solve the equation over the real numbers.",
      "parts": [
        {
          "label": "",
          "prompt": "$4^{x+1}3^x=6^{x+1}$. Give an exact answer.",
          "marks": 6
        }
      ],
      "answerSummary": "$x=\\log_2 3-1$.",
      "markScheme": [
        {
          "part": "",
          "steps": [
            {
              "code": "M1",
              "text": "Write $4\\cdot4^x3^x=6\\cdot6^x$."
            },
            {
              "code": "A1",
              "text": "$4^x3^x/6^x=6/4$."
            },
            {
              "code": "A1",
              "text": "$(4\\cdot3/6)^x=3/2$."
            },
            {
              "code": "A1",
              "text": "$2^x=3/2$."
            },
            {
              "code": "M1",
              "text": "Take logarithms base 2."
            },
            {
              "code": "A1",
              "text": "$x=\\log_2(3/2)=\\log_2 3-1$."
            }
          ]
        }
