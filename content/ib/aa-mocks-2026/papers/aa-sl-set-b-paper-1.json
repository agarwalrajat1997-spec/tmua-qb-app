    {
      "number": 9,
      "section": "B",
      "marks": 12,
      "stem": "Let $f(x)=e^{2x}+e^x+x-6$, with domain $\\mathbb{R}$. The graph of $f$ is provided.",
      "parts": [
        {
          "label": "a(i)",
          "prompt": "Show that $f$ is strictly increasing.",
          "marks": 2
        },
        {
          "label": "a(ii)",
          "prompt": "Show that its graph is concave upwards.",
          "marks": 2
        },
        {
          "label": "b",
          "prompt": "On the same axes, sketch $y=f^{-1}(x)$ and $y=x$. Label the $x$-intercept of the inverse and show the common intersection of the three graphs.",
          "marks": 4
        },
        {
          "label": "c",
          "prompt": "The graph $y=2f(x)+k$ passes through the origin. Find $k$.",
          "marks": 2
        },
        {
          "label": "d",
          "prompt": "Simplify $f(\\ln x)-\\ln x$, for $x>0$.",
          "marks": 2
        }
      ],
      "answerSummary": "Increasing and concave up; inverse intercept $(-4,0)$, fixed point $(\\ln2,\\ln2)$; $k=8$; $x^2+x-6$.",
      "markScheme": [
        {
          "part": "a(i)",
          "steps": [
            {
              "code": "M1",
              "text": "$f\\,\\!\\prime(x)=2e^{2x}+e^x+1$."
            },
            {
              "code": "A1",
              "text": "Every term is positive, so $f\\,\\!\\prime(x)>0$ for all real $x$."
            }
          ]
        },
        {
          "part": "a(ii)",
          "steps": [
            {
              "code": "A1",
              "text": "$f\\,\\!\\prime\\prime(x)=4e^{2x}+e^x$."
            },
            {
              "code": "A1",
              "text": "This is positive for every real $x$, proving the required concavity."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "A1",
              "text": "The inverse graph is the reflection of $y=f(x)$ in $y=x$."
            },
            {
              "code": "A1",
              "text": "Draw the line $y=x$."
            },
            {
              "code": "A1",
              "text": "The graphs meet at the same fixed point on that line; $(\\ln2,\\ln2)$ if labelled."
            },
            {
              "code": "A1",
              "text": "The inverse $x$-intercept is $(-4,0)$."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "M1",
              "text": "$f(0)=-4$, so the transformed $y$-intercept is $-8+k$."
            },
            {
              "code": "A1",
              "text": "$k=8$."
            }
          ]
        },
        {
          "part": "d",
          "steps": [
            {
              "code": "M1",
              "text": "Substitute $\\ln x$: $e^{2\\ln x}+e^{\\ln x}+\\ln x-6-\\ln x$."
            },
            {
              "code": "A1",
              "text": "This simplifies to $x^2+x-6$."
            }
          ]
        }
      ],
