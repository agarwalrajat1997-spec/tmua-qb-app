    {
      "number": 3,
      "section": "A",
      "marks": 7,
      "stem": "Initially consider $f(x)=2x^2+20x+54$ for all real $x$.",
      "parts": [
        {
          "label": "a",
          "prompt": "State the range of $f$.",
          "marks": 1
        },
        {
          "label": "b",
          "prompt": "The domain is now restricted to $x\\le k$. Explain why a restriction is needed for an inverse function, and find the largest possible value of $k$.",
          "marks": 2
        },
        {
          "label": "c",
          "prompt": "Using this value of $k$, find $f^{-1}(x)$, stating its domain.",
          "marks": 4
        }
      ],
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "The vertex is$(-5,4)$and the range is$[4,\\infty)$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "R1",
              "text": "The unrestricted parabola fails the horizontal-line test; the left branch must not extend past its vertex."
            },
            {
              "code": "A1",
              "text": "$k=-5$."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "M1",
              "text": "$y=2(x+5)^2+4$."
            },
            {
              "code": "A1",
              "text": "$(x+5)^2=(y-4)/2$."
            },
            {
              "code": "A1",
              "text": "Because$x\\le-5$, take$x+5=-\\sqrt{(y-4)/2}$."
            },
            {
              "code": "A1",
              "text": "$f^{-1}(x)=-5-\\sqrt{(x-4)/2}$, with$x\\ge4$."
            }
          ]
        }
      ],
      "answerSummary": "The vertex is$(-5,4)$and the range is$[4,\\infty)$. $k=-5$. $(x+5)^2=(y-4)/2$. Because$x\\le-5$, take$x+5=-\\sqrt{(y-4)/2}$. $f^{-1}(x)=-5-\\sqrt{(x-4)/2}$, with$x\\ge4$.",
      "sourcePages": [
        4
      ]
    },
    {
      "number": 4,
      "section": "A",
      "marks": 9,
      "stem": "All trigonometric inverse functions in this question use radians.",
      "parts": [
        {
          "label": "a",
          "prompt": "Using the substitution $u=x^2$, find $\\displaystyle\\int\\frac{x}{1+x^4}\\,dx$.",
          "marks": 4
        },
        {
          "label": "b",
          "prompt": "Evaluate $\\displaystyle\\int_0^1\\frac{x}{1+x^4}\\,dx$.",
          "marks": 1
        },
        {
          "label": "c",
          "prompt": "Write $\\displaystyle\\int_0^1\\frac{2x+k}{1+x^4}\\,dx$ in the form $A+Bk$, and find numerical values of $A$ and $B$ to four significant figures.",
          "marks": 4
        }
      ],
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "$u=x^2$gives$du=2x\\,dx$."
            },
            {
              "code": "A1",
              "text": "The integral becomes$\\frac12\\int(1+u^2)^{-1}du$."
            },
            {
              "code": "A1",
              "text": "This is$\\frac12\\arctan u+C$."
            },
            {
              "code": "A1",
              "text": "$\\frac12\\arctan(x^2)+C$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "A1",
              "text": "$\\frac12[\\arctan(x^2)]_0^1=\\pi/8\\approx0.393$."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "M1",
              "text": "Split by linearity into the$2x$term and the$k$term."
            },
            {
              "code": "M1",
              "text": "$A=\\int_0^1 2x/(1+x^4)dx$and$B=\\int_0^1 1/(1+x^4)dx$."
            },
            {
              "code": "A1",
              "text": "$A=\\pi/4\\approx0.7854$."
            },
            {
              "code": "A1",
              "text": "$B\\approx0.8670$."
            }
          ]
        }
      ],
      "answerSummary": "The integral becomes$\\frac12\\int(1+u^2)^{-1}du$. This is$\\frac12\\arctan u+C$. $\\frac12\\arctan(x^2)+C$. $\\frac12[\\arctan(x^2)]_0^1=\\pi/8\\approx0.393$. $A=\\pi/4\\approx0.7854$. $B\\approx0.8670$.",
      "sourcePages": [
        5
      ]
    },
