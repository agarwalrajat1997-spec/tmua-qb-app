      "diagramSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 520\" role=\"img\" aria-label=\"Pyramid geometry and ant paths\"><rect width=\"900\" height=\"520\" fill=\"white\"/><text x=\"450\" y=\"30\" font-family=\"Arial,sans-serif\" font-size=\"21\" text-anchor=\"middle\" fill=\"#111\">Square-based pyramid; lengths shown in metres</text><path d=\"M120 400L650 400\" stroke=\"#111\" stroke-width=\"2\" fill=\"none\"/><path d=\"M650 400L780 280\" stroke=\"#111\" stroke-width=\"2\" fill=\"none\"/><path d=\"M780 280L250 280\" stroke=\"#111\" stroke-width=\"2\" fill=\"none\"/><path d=\"M250 280L120 400\" stroke=\"#111\" stroke-width=\"2\" fill=\"none\"/><path d=\"M450 80L120 400\" stroke=\"#111\" stroke-width=\"2\" fill=\"none\"/><path d=\"M450 80L650 400\" stroke=\"#111\" stroke-width=\"2\" fill=\"none\"/><path d=\"M450 80L780 280\" stroke=\"#111\" stroke-width=\"2\" fill=\"none\"/><path d=\"M450 80L250 280\" stroke=\"#111\" stroke-width=\"2\" fill=\"none\"/><path d=\"M450 80L450 340\" stroke=\"#111\" stroke-width=\"2\" fill=\"none\" stroke-dasharray=\"7 5\"/><path d=\"M120 400L780 280\" stroke=\"#111\" stroke-width=\"2\" fill=\"none\" stroke-dasharray=\"7 5\"/><text x=\"105\" y=\"420\" font-family=\"Arial,sans-serif\" font-size=\"19\" text-anchor=\"middle\" fill=\"#111\">A</text><text x=\"665\" y=\"423\" font-family=\"Arial,sans-serif\" font-size=\"19\" text-anchor=\"middle\" fill=\"#111\">B</text><text x=\"798\" y=\"282\" font-family=\"Arial,sans-serif\" font-size=\"19\" text-anchor=\"middle\" fill=\"#111\">C</text><text x=\"238\" y=\"275\" font-family=\"Arial,sans-serif\" font-size=\"19\" text-anchor=\"middle\" fill=\"#111\">D</text><text x=\"450\" y=\"65\" font-family=\"Arial,sans-serif\" font-size=\"19\" text-anchor=\"middle\" fill=\"#111\">P</text><text x=\"465\" y=\"362\" font-family=\"Arial,sans-serif\" font-size=\"19\" text-anchor=\"middle\" fill=\"#111\">Q</text><text x=\"365\" y=\"430\" font-family=\"Arial,sans-serif\" font-size=\"19\" tex