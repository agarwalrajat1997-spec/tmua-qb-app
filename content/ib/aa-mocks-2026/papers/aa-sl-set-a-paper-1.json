  "questions": [
    {
      "number": 1,
      "section": "A",
      "marks": 5,
      "stem": "Let $f(x)=\\dfrac{x-1}{2-x}$, with domain $\\mathbb{R}\\setminus\\{2\\}$.",
      "parts": [
        {
          "label": "a",
          "prompt": "State the range of $f$.",
          "marks": 1
        },
        {
          "label": "b",
          "prompt": "Find an expression for $f^{-1}(x)$.",
          "marks": 4
        }
      ],
      "answerSummary": "Range excludes $-1$; $f^{-1}(x)=(2x+1)/(x+1)$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$\\mathbb{R}\\setminus\\{-1\\}$, or $y\\ne-1$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "Write $y=(x-1)/(2-x)$ and interchange the variables, or rearrange before interchanging."
            },
            {
              "code": "M1",
              "text": "$x-1=2y-xy\\implies x(1+y)=2y+1$."
            },
            {
              "code": "A1",
              "text": "$x=(2y+1)/(y+1)$."
            },
            {
              "code": "A1",
              "text": "$f^{-1}(x)=(2x+1)/(x+1)$, for $x\\ne-1$."
            }
          ]
        }
      ],
      "sourcePages": [
        2
      ]
    },
    {
      "number": 2,
      "section": "A",
      "marks": 6,
      "stem": "Angles in this question are measured in radians.",
      "parts": [
        {
          "label": "a",
          "prompt": "Express $8\\sin x\\cos x$ as a single sine expression.",
          "marks": 2
        },
        {
          "label": "b",
          "prompt": "Hence evaluate $\\displaystyle\\int_0^{\\pi/2}8\\sin x\\cos x\\,\\mathrm{d}x$.",
          "marks": 4
        }
      ],
      "answerSummary": "$4\\sin2x$; integral $4$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "Use $\\sin 2x=2\\sin x\\cos x$."
            },
            {
              "code": "A1",
              "text": "$8\\sin x\\cos x=4\\sin 2x$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "A1",
              "text": "An antiderivative is $-2\\cos2x$."
            },
            {
              "code": "M1",
              "text": "Evaluate $[-2\\cos2x]_0^{\\pi/2}$."
            },
            {
              "code": "A1",
              "text": "$-2\\cos\\pi+2\\cos0=2+2$."
            },
            {
              "code": "A1",
              "text": "The integral equals $4$."
            }
          ]
        }
      ],
      "sourcePages": [
        3
      ]
    },
    {
      "number": 3,
      "section": "A",
      "marks": 6,
      "stem": "Angles are measured in degrees.",
      "parts": [
        {
          "label": "",
          "prompt": "Solve $\\sin(2x-10^\\circ)=1$ for $0^\\circ\\le x\\le360^\\circ$.",
          "marks": 6
        }
      ],
      "answerSummary": "$x=50^\\circ,230^\\circ$.",
      "markScheme": [
        {
          "part": "",
          "steps": [
            {
              "code": "M1",
              "text": "Use $\\sin\\theta=1$ at $\\theta=90^\\circ+360^\\circ k$."
            },
            {
              "code": "A1",
              "text": "$2x-10^\\circ=90^\\circ+360^\\circ k$."
            },
            {
              "code": "A1",
              "text": "$2x=100^\\circ+360^\\circ k$."
            },
            {
              "code": "A1",
              "text": "$x=50^\\circ+180^\\circ k$."
            },
            {
              "code": "A1",
              "text": "$x=50^\\circ$."
            },
            {
              "code": "A1",
              "text": "$x=230^\\circ$, with no other values in the specified interval."
            }
          ]
        }
      ],
      "sourcePages": [
        4
      ]
    },
    {
      "number": 4,
      "section": "A",
      "marks": 5,
      "stem": "A discrete random variable $X$ has the following distribution.\n\n| $x$ | $1$ | $2$ | $3$ |\n|---|---|---|---|\n| $P(X=x)$ | $p$ | $0.7-p$ | $q$ |\n\nThe expectation of $X$ is $2.1$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $q$.",
          "marks": 2
        },
        {
          "label": "b",
          "prompt": "Find $p$.",
          "marks": 3
        }
      ],
      "answerSummary": "$q=0.3$, $p=0.2$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "$p+(0.7-p)+q=1$."
            },
            {
              "code": "A1",
              "text": "$q=0.3$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "Use $E(X)=p+2(0.7-p)+3q=2.1$."
            },
            {
              "code": "A1",
              "text": "$p+1.4-2p+0.9=2.1$."
            },
            {
              "code": "A1",
              "text": "$p=0.2$."
            }
          ]
        }
      ],
      "sourcePages": [
        5
      ]
    },
    {
      "number": 5,
      "section": "A",
      "marks": 6,
      "stem": "Consider logarithms of real arguments.",
      "parts": [
        {
          "label": "a",
          "prompt": "Write $\\log_8(x+2)$ in terms of $\\log_2(x+2)$.",
          "marks": 1
        },
        {
          "label": "b",
          "prompt": "Hence solve $3\\log_8(x+2)-2\\log_2(x+1)=1$.",
          "marks": 5
        }
      ],
      "answerSummary": "Change of base factor $1/3$; only $x=0$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$\\log_8(x+2)=\\dfrac{\\log_2(x+2)}3$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "Convert to base 2 and combine logarithms."
            },
            {
              "code": "A1",
              "text": "$\\log_2\\left((x+2)/(x+1)^2\\right)=1$."
            },
            {
              "code": "M1",
              "text": "$x+2=2(x+1)^2$."
            },
            {
              "code": "A1",
              "text": "$x(2x+3)=0$, giving $0$ or $-3/2$."
            },
            {
              "code": "A1",
              "text": "Original arguments require $x>-1$, so reject $-3/2$ and obtain $x=0$."
            }
          ]
        }
      ],
      "sourcePages": [
        6
      ]
    },
    {
      "number": 6,
      "section": "A",
      "marks": 6,
      "stem": "An arithmetic sequence has first term $u_1$ and common difference $d$. Its first $n$ terms have sum $S_n$. It is given that $S_3=S_8$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Show that $u_1=-5d$.",
          "marks": 4
        },
        {
          "label": "b",
          "prompt": "Hence find $u_6$.",
          "marks": 2
        }
      ],
      "answerSummary": "$u_1=-5d$ and $u_6=0$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "Use $S_n=n[2u_1+(n-1)d]/2$."
            },
            {
              "code": "A1",
              "text": "$\\frac32(2u_1+2d)=\\frac82(2u_1+7d)$."
            },
            {
              "code": "A1",
              "text": "$3u_1+3d=8u_1+28d$."
            },
            {
              "code": "A1",
              "text": "$5u_1=-25d$, hence $u_1=-5d$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "$u_6=u_1+5d$."
            },
            {
              "code": "A1",
              "text": "$u_6=0$."
            }
          ]
        }
      ],
      "sourcePages": [
        7
      ]
    },
    {
      "number": 7,
      "section": "A",
      "marks": 6,
      "stem": "Let $f(x)=ax^3+2ax^2+bx+3a$, where $a,b\\in\\mathbb{R}$. The graph has a stationary point at $(1,3)$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $f\\,\\!\\prime(x)$.",
          "marks": 2
        },
        {
          "label": "b",
          "prompt": "Find $a$ and $b$.",
          "marks": 4
        }
      ],
      "answerSummary": "$f\\,\\!\\prime(x)=3ax^2+4ax+b$; $a=-3,b=21$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "Differentiate the cubic and quadratic terms to obtain $3ax^2+4ax$."
            },
            {
              "code": "A1",
              "text": "$f\\,\\!\\prime(x)=3ax^2+4ax+b$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "A1",
              "text": "$f(1)=3\\implies6a+b=3$."
            },
            {
              "code": "M1",
              "text": "Use the stationary-point condition $f\\,\\!\\prime(1)=0$."
            },
            {
              "code": "A1",
              "text": "$7a+b=0$."
            },
            {
              "code": "A1",
              "text": "$a=-3$, $b=21$."
            }
          ]
        }
      ],
      "sourcePages": [
        8
      ]
    },
    {
      "number": 8,
      "section": "B",
      "marks": 11,
      "stem": "Let $f(x)=ax^2+bx+8$, where $a\\ne0$, and let $g(x)=4ax^2+2bx+8$ and $h(x)=4ax^2+4bx+33$.",
      "parts": [
        {
          "label": "a(i)",
          "prompt": "Write $g(x)$ in terms of $f$ and describe the transformation taking the graph of $f$ to that of $g$.",
          "marks": 3
        },
        {
          "label": "a(ii)",
          "prompt": "Two points on the graph of $f$ have $x$-coordinates $2$ and $4$. State the $x$-coordinates of their corresponding points on the graph of $g$.",
          "marks": 1
        },
        {
          "label": "b",
          "prompt": "Describe a sequence of transformations taking the graph of $f$ to that of $h$.",
          "marks": 3
        },
        {
          "label": "c",
          "prompt": "The vertex of the graph of $f$ is $(-1,a)$. Find $a$ and $b$.",
          "marks": 4
        }
      ],
      "answerSummary": "$g=f(2x)$; $x=1,2$; $h=4f+1$; $a=4,b=8$.",
      "markScheme": [
        {
          "part": "a(i)",
          "steps": [
            {
              "code": "A1",
              "text": "$g(x)=f(2x)$."
            },
            {
              "code": "A1",
              "text": "The transformation is a horizontal stretch/compression."
            },
            {
              "code": "A1",
              "text": "The scale factor parallel to the $x$-axis is $1/2$."
            }
          ]
        },
        {
          "part": "a(ii)",
          "steps": [
            {
              "code": "A1",
              "text": "$1$ and $2$, respectively."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "$h(x)=4f(x)+1$."
            },
            {
              "code": "A1",
              "text": "Vertical stretch of scale factor 4."
            },
            {
              "code": "A1",
              "text": "Vertical translation 1 unit upwards; stretch then translate."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "M1",
              "text": "$-b/(2a)=-1\\implies b=2a$."
            },
            {
              "code": "M1",
              "text": "$f(-1)=a$."
            },
            {
              "code": "A1",
              "text": "$a-b+8=a\\implies b=8$."
            },
            {
              "code": "A1",
              "text": "$a=4$."
            }
          ]
        }
      ],
      "sourcePages": [
        9
      ]
    },
    {
      "number": 9,
      "section": "B",
      "marks": 14,
      "stem": "A black box contains 1 red ball and 4 blue balls. A white box contains 2 red balls and 3 blue balls. A fair six-sided die is rolled: the black box is selected for scores 1,2,3 and the white box otherwise. One ball is drawn at random from the selected box.\n\nFor part(d) only, change the rule: select the black box when the die score is $a$ or below, where $a$ is an integer from 1 to 5; otherwise select the white box.",
      "parts": [
        {
          "label": "a",
          "prompt": "Copy and complete the probability tree, labelling every branch.",
          "marks": 3
        },
        {
          "label": "b",
          "prompt": "Find the probability that the drawn ball is blue.",
          "marks": 2
        },
        {
          "label": "c",
          "prompt": "Given that the drawn ball is red, find the probability that it came from the black box.",
          "marks": 3
        },
        {
          "label": "d",
          "prompt": "Under the changed rule, $P(\\mathrm{black}\\mid\\mathrm{red})=1/5$. Find $a$.",
          "marks": 6
        }
      ],
      "answerSummary": "$P(blue)=7/10$, $P(black\\mid red)=1/3$ under original rule; changed threshold $a=2$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "The box-selection probabilities are both $1/2$."
            },
            {
              "code": "A1",
              "text": "Black-box probabilities: red $1/5$, blue $4/5$."
            },
            {
              "code": "A1",
              "text": "White-box probabilities: red $2/5$, blue $3/5$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "A1",
              "text": "$P(\\mathrm{blue})=(1/2)(4/5)+(1/2)(3/5)$."
            },
            {
              "code": "A1",
              "text": "$P(\\mathrm{blue})=7/10$."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "A1",
              "text": "$P(\\mathrm{red})=3/10$."
            },
            {
              "code": "M1",
              "text": "$P(\\mathrm{black}\\mid\\mathrm{red})=P(\\mathrm{black}\\cap\\mathrm{red})/P(\\mathrm{red})$."
            },
            {
              "code": "A1",
              "text": "$[(1/2)(1/5)]/(3/10)=1/3$."
            }
          ]
        },
        {
          "part": "d",
          "steps": [
            {
              "code": "M1",
              "text": "Let $p=P(\\mathrm{black})=a/6$."
            },
            {
              "code": "A1",
              "text": "$P(\\mathrm{red})=p/5+2(1-p)/5=(2-p)/5$."
            },
            {
              "code": "M1",
              "text": "Apply conditional probability with numerator $p/5$."
            },
            {
              "code": "A1",
              "text": "$P(\\mathrm{black}\\mid\\mathrm{red})=p/(2-p)$."
            },
            {
              "code": "A1",
              "text": "$p/(2-p)=1/5\\implies p=1/3$."
            },
            {
              "code": "A1",
              "text": "$a=2$, so select black for scores 1 or 2."
            }
          ]
        }
      ],
      "sourcePages": [
        10
      ],
