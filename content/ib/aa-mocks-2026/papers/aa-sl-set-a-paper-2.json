  "questions": [
    {
      "number": 1,
      "section": "A",
      "marks": 5,
      "stem": "Four observations, listed in ascending order, are $a,b,10,10$. Their median is 8 and their mean is 7.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $b$.",
          "marks": 1
        },
        {
          "label": "b",
          "prompt": "Find $a$.",
          "marks": 2
        },
        {
          "label": "c",
          "prompt": "Find the population standard deviation of these observations.",
          "marks": 2
        }
      ],
      "answerSummary": "$b=6,a=2,\\sigma=3.32$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$(b+10)/2=8$, so $b=6$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "$(a+6+10+10)/4=7$."
            },
            {
              "code": "A1",
              "text": "$a=2$."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "A2",
              "text": "$\\sigma=\\sqrt{11}=3.31662\\ldots\\approx3.32$."
            }
          ]
        }
      ],
      "sourcePages": [
        2
      ]
    },
    {
      "number": 2,
      "section": "A",
      "marks": 5,
      "stem": "Let $f(x)=\\ln(x+2)$ for $x>-2$, and $g(x)=e^x$ for $x\\in\\mathbb{R}$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $(g\\circ f)(x)$.",
          "marks": 2
        },
        {
          "label": "b",
          "prompt": "Solve $(g\\circ f)(x)=(f\\circ g)(x)$.",
          "marks": 3
        }
      ],
      "answerSummary": "$(g\\circ f)(x)=x+2$; equality at $x\\approx-1.16$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$(g\\circ f)(x)=e^{\\ln(x+2)}$."
            },
            {
              "code": "A1",
              "text": "$(g\\circ f)(x)=x+2$, for $x>-2$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "A1",
              "text": "$x+2=\\ln(e^x+2)$."
            },
            {
              "code": "A2",
              "text": "Graphical/numerical solution $x=-1.16144\\ldots\\approx-1.16$. Exact $x=\\ln[2/(e^2-1)]$ also accepted."
            }
          ]
        }
      ],
      "sourcePages": [
        3
      ]
    },
    {
      "number": 3,
      "section": "A",
      "marks": 5,
      "stem": "A measurement $X$ follows a normal distribution with mean 230 and standard deviation 9, so $X\\sim N(230,9^2)$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $P(X>240)$.",
          "marks": 2
        },
        {
          "label": "b",
          "prompt": "Find $a$ such that $P(a<X<230)=P(X>240)$.",
          "marks": 3
        }
      ],
      "answerSummary": "$P(X>240)=0.133$ and $a\\approx227$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "Use the upper normal tail with standardized value $(240-230)/9$."
            },
            {
              "code": "A1",
              "text": "$P(X>240)=0.133260\\ldots\\approx0.133$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "$P(X>a)=0.5+P(X>240)$."
            },
            {
              "code": "A1",
              "text": "$P(X>a)=0.633260\\ldots$."
            },
            {
              "code": "A1",
              "text": "$a=226.935\\ldots\\approx227$."
            }
          ]
        }
      ],
      "sourcePages": [
        4
      ]
    },
    {
      "number": 4,
      "section": "A",
      "marks": 5,
      "stem": "Let $f(x)=x^2\\ln(x-2)+1$, for $x>2$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $f\\,\\!\\prime(3)$.",
          "marks": 2
        },
        {
          "label": "b(i)",
          "prompt": "Find an equation of the normal to the graph at $x=3$ in point-gradient form.",
          "marks": 2
        },
        {
          "label": "b(ii)",
          "prompt": "Write this equation in the form $y=mx+c$.",
          "marks": 1
        }
      ],
      "answerSummary": "$f\\,\\!\\prime(3)=9$; normal $y-1=-(x-3)/9$, or $y=-x/9+4/3$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A2",
              "text": "$f\\,\\!\\prime(3)=9$."
            }
          ]
        },
        {
          "part": "b(i)",
          "steps": [
            {
              "code": "A1",
              "text": "The normal gradient is $-1/9$."
            },
            {
              "code": "A1",
              "text": "$y-1=-(x-3)/9$."
            }
          ]
        },
        {
          "part": "b(ii)",
          "steps": [
            {
              "code": "A1",
              "text": "$y=-x/9+4/3$."
            }
          ]
        }
      ],
      "sourcePages": [
        5
      ]
    },
    {
      "number": 5,
      "section": "A",
      "marks": 6,
      "stem": "In the expansion of $(2x+ax^2)^7$, where $a\\in\\mathbb{R}$, the coefficient of $x^9$ is 6048.",
      "parts": [
        {
          "label": "",
          "prompt": "Find all possible values of $a$.",
          "marks": 6
        }
      ],
      "answerSummary": "$a=\\pm3$.",
      "markScheme": [
        {
          "part": "",
          "steps": [
            {
              "code": "M1",
              "text": "Use the general term $\\binom7r(2x)^{7-r}(ax^2)^r$."
            },
            {
              "code": "A1",
              "text": "The exponent is $7+r=9$, so $r=2$."
            },
            {
              "code": "A1",
              "text": "The coefficient is $\\binom72\\,2^5a^2=672a^2$."
            },
            {
              "code": "M1",
              "text": "Set $672a^2=6048$."
            },
            {
              "code": "A1",
              "text": "$a^2=9$."
            },
            {
              "code": "A1",
              "text": "$a=3$ or $a=-3$."
            }
          ]
        }
      ],
      "sourcePages": [
        6
      ]
    },
    {
      "number": 6,
      "section": "A",
      "marks": 7,
      "stem": "A minor sector $OAB$ has radius $r$ centimetres and angle $\\theta$ radians, where $0<\\theta<\\pi$. The area between its chord $AB$ and its minor arc is $3.35\\,\\mathrm{cm}^2$. The perimeter of the sector, including both radii, is 16 cm.",
      "parts": [
        {
          "label": "a",
          "prompt": "Show that $r^2(\\theta-\\sin\\theta)=6.7$.",
          "marks": 3
        },
        {
          "label": "b",
          "prompt": "Find $\\theta$ and $r$.",
          "marks": 4
        }
      ],
      "answerSummary": "$\\theta\\approx1.20$ radians and $r\\approx5.00$cm.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "Subtract triangle $OAB$ from the sector."
            },
            {
              "code": "A1",
              "text": "The two areas are $r^2\\theta/2$ and $r^2\\sin\\theta/2$."
            },
            {
              "code": "A1",
              "text": "$r^2(\\theta-\\sin\\theta)/2=3.35$, giving the result."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "A1",
              "text": "$r(\\theta+2)=16$, so $r=16/(\\theta+2)$."
            },
            {
              "code": "M1",
              "text": "Solve $[16/(\\theta+2)]^2(\\theta-\\sin\\theta)=6.7$ on $(0,\\pi)$."
            },
            {
              "code": "A1",
              "text": "$\\theta=1.200083\\ldots\\approx1.20$ radians."
            },
            {
              "code": "A1",
              "text": "$r=4.999870\\ldots\\approx5.00\\,\\mathrm{cm}$."
            }
          ]
        }
      ],
      "sourcePages": [
        7
      ],
