  "questions": [
    {
      "number": 1,
      "section": "A",
      "marks": 4,
      "stem": "Events $A$ and $B$ are independent, with $P(A)=0.34$ and $P(B)=0.45$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $P(A\\cap B)$.",
          "marks": 2
        },
        {
          "label": "b",
          "prompt": "Find $P(A\\cup B)$.",
          "marks": 2
        }
      ],
      "answerSummary": "$P(A\\cap B)=0.153$ and $P(A\\cup B)=0.637$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "Independence gives $P(A\\cap B)=P(A)P(B)$."
            },
            {
              "code": "A1",
              "text": "$P(A\\cap B)=0.153$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "Use $P(A)+P(B)-P(A\\cap B)$."
            },
            {
              "code": "A1",
              "text": "$P(A\\cup B)=0.637$."
            }
          ]
        }
      ],
      "sourcePages": [
        2
      ]
    },
    {
      "number": 2,
      "section": "A",
      "marks": 6,
      "stem": "Five paired measurements are shown. The $x$-measurements are integers. The regression line of $y$ on $x$, with its coefficients rounded to 3 decimal places, is $y=2.398x+101.446$.\n\n| $x$ |12|15|17|$a$|28|\n|---|---|---|---|---|---|\n| $y$ |127|142|144|151|171|",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $\\bar y$.",
          "marks": 1
        },
        {
          "label": "b(i)",
          "prompt": "Use the regression line to estimate $\\bar x$, giving your answer to the nearest whole number.",
          "marks": 2
        },
        {
          "label": "b(ii)",
          "prompt": "Hence find $a$.",
          "marks": 2
        },
        {
          "label": "c",
          "prompt": "Find the Pearson correlation coefficient $r$.",
          "marks": 1
        }
      ],
      "answerSummary": "$\\bar y=147$, $\\bar x\\approx19$, $a=23$, $r\\approx0.964$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$\\bar y=735/5=147$."
            }
          ]
        },
        {
          "part": "b(i)",
          "steps": [
            {
              "code": "M1",
              "text": "The regression line passes through $(\\bar x,\\bar y)$, so $147=2.398\\bar x+101.446$ approximately."
            },
            {
              "code": "A1",
              "text": "$\\bar x\\approx18.9967$, giving 19 to the requested accuracy."
            }
          ]
        },
        {
          "part": "b(ii)",
          "steps": [
            {
              "code": "M1",
              "text": "$(12+15+17+a+28)/5=19$."
            },
            {
              "code": "A1",
              "text": "$a=23$."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "A1",
              "text": "$r=0.964395\\ldots\\approx0.964$."
            }
          ]
        }
      ],
      "sourcePages": [
        3
      ]
    },
    {
      "number": 3,
      "section": "A",
      "marks": 5,
      "stem": "Let $f(x)=2x^2+20x+54$, restricted to $x\\le-5$.",
      "parts": [
        {
          "label": "a",
          "prompt": "The range is $y\\ge h$. Find $h$.",
          "marks": 1
        },
        {
          "label": "b",
          "prompt": "Find $f^{-1}(x)$.",
          "marks": 4
        }
      ],
      "answerSummary": "$h=4$ and $f^{-1}(x)=-5-\\sqrt{(x-4)/2}$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$f(x)=2(x+5)^2+4$, so $h=4$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "$y=2(x+5)^2+4$."
            },
            {
              "code": "A1",
              "text": "$(x+5)^2=(y-4)/2$."
            },
            {
              "code": "A1",
              "text": "Choose $x+5=-\\sqrt{(y-4)/2}$, because $x\\le-5$."
            },
            {
              "code": "A1",
              "text": "$f^{-1}(x)=-5-\\sqrt{(x-4)/2}$, for $x\\ge4$."
            }
          ]
        }
      ],
      "sourcePages": [
        4
      ]
    },
    {
      "number": 4,
      "section": "A",
      "marks": 6,
      "stem": "A fair coin is tossed 12 times independently. Let $X$ be the number of tails.",
      "parts": [
        {
          "label": "a",
          "prompt": "State the distribution of $X$ and find the probability of obtaining equal numbers of heads and tails.",
          "marks": 3
        },
        {
          "label": "b",
          "prompt": "Find the probability of obtaining more tails than heads.",
          "marks": 3
        }
      ],
      "answerSummary": "$X\\sim\\operatorname{Bin}(12,1/2)$; equal 0.226, more tails 0.387.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$X\\sim\\operatorname{Bin}(12,1/2)$."
            },
            {
              "code": "M1",
              "text": "Calculate $P(X=6)$."
            },
            {
              "code": "A1",
              "text": "$P(X=6)=0.225585\\ldots\\approx0.226$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "Exclude the equal-count outcome, leaving probability $1-P(X=6)$."
            },
            {
              "code": "M1",
              "text": "By symmetry, halve the remaining probability; alternatively calculate $P(X\\ge7)$ directly."
            },
            {
              "code": "A1",
              "text": "The probability is $0.387207\\ldots\\approx0.387$."
            }
          ]
        }
      ],
      "sourcePages": [
        5
      ]
    },
    {
      "number": 5,
      "section": "A",
      "marks": 7,
      "stem": "A right square-based pyramid $PABCD$ has base side 6 cm. The apex $P$ is vertically above the centre $Q$ of the square, and $PQ=3\\sqrt2$cm.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find the exact volume of the pyramid.",
          "marks": 2
        },
        {
          "label": "b",
          "prompt": "Find the exact length $AC$.",
          "marks": 2
        },
        {
          "label": "c",
          "prompt": "Show that triangle $PAB$ is equilateral.",
          "marks": 3
        }
      ],
      "answerSummary": "$V=36\\sqrt2$, $AC=6\\sqrt2$, and $PA=PB=AB=6$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "M1",
              "text": "Use one third of base area times perpendicular height."
            },
            {
              "code": "A1",
              "text": "$V=(1/3)(6)(6)(3\\sqrt2)=36\\sqrt2\\,\\mathrm{cm}^3$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "$AC^2=6^2+6^2$."
            },
            {
              "code": "A1",
              "text": "$AC=6\\sqrt2$cm."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "A1",
              "text": "$AQ=AC/2=3\\sqrt2$."
            },
            {
              "code": "A1",
              "text": "$PA^2=AQ^2+PQ^2=18+18=36$, so $PA=6$; similarly $PB=6$."
            },
            {
              "code": "R1",
              "text": "$PA=PB=AB=6$, hence the triangle is equilateral."
            }
          ]
        }
      ],
      "sourcePages": [
        6
      ],
