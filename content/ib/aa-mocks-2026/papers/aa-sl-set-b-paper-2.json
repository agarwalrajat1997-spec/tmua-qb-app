\" cy=\"315\" r=\"4\" fill=\"#111\"/><text x=\"414.5\" y=\"333\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"18\" fill=\"#111\">Q</text><text x=\"350\" y=\"405\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"18\" fill=\"#111\">6 cm</text><text x=\"378\" y=\"225\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"16\" fill=\"#111\">3√2 cm</text><path d=\"M413 225L432.5 225\" fill=\"none\" stroke=\"#111\" stroke-width=\"2\"/><text x=\"410\" y=\"455\" text-anchor=\"middle\" font-family=\"Arial,sans-serif\" font-size=\"16\" fill=\"#111\">Q is the centre of the square base; PQ is perpendicular to its plane.</text></svg>"
    },
    {
      "number": 6,
      "section": "A",
      "marks": 6,
      "stem": "Consider $\\cos(\\pi x/10)=0$ on the interval $0\\le x\\le1000$.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find all solutions, using a formula with an integer parameter.",
          "marks": 3
        },
        {
          "label": "b",
          "prompt": "Find the sum of all these solutions.",
          "marks": 3
        }
      ],
      "answerSummary": "$x=5+10k$, $k=0,\\ldots,99$; sum 50,000.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A2",
              "text": "$x=5+10k$."
            },
            {
              "code": "A1",
              "text": "$k=0,1,\\ldots,99$; the solutions are 5,15,25,...,995."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "Use the arithmetic-series sum with 100 terms, first 5 and last 995."
            },
            {
              "code": "A2",
              "text": "The sum is $100(5+995)/2=50\\,000$."
            }
          ]
        }
      ],
      "sourcePages": [
