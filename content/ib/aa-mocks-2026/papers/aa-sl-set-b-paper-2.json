    {
      "number": 8,
      "section": "B",
      "marks": 14,
      "stem": "Two fair six-sided dice are rolled independently. Let $D$ be the absolute difference of their scores.",
      "parts": [
        {
          "label": "a",
          "prompt": "Find $P(D=0)$.",
          "marks": 1
        },
        {
          "label": "b",
          "prompt": "Find $P(D=5)$.",
          "marks": 2
        },
        {
          "label": "c",
          "prompt": "Find $P(D=4)$.",
          "marks": 3
        },
        {
          "label": "d",
          "prompt": "Complete the following probability table by finding $x,y,z$.\n\n| $d$ |0|1|2|3|4|5|\n|---|---|---|---|---|---|---|\n| $P(D=d)$ | $6/36$ | $10/36$ | $x/36$ | $6/36$ | $y/36$ | $z/36$ |",
          "marks": 2
        },
        {
          "label": "e",
          "prompt": "Find $E(D)$.",
          "marks": 2
        },
        {
          "label": "f",
          "prompt": "A game gives a net profit of 7 dollars if $D=5$, a net profit of 1 dollar if $D=1$, and a net loss of $L$ dollars otherwise. Find $L$ if the game is fair.",
          "marks": 4
        }
      ],
      "answerSummary": "Distribution numerators 6,10,8,6,4,2; $E(D)=35/18$, fair loss $L=1$.",
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "A1",
              "text": "$P(D=0)=6/36=1/6$."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "M1",
              "text": "The ordered outcomes are $(1,6)$ and $(6,1)$."
            },
            {
              "code": "A1",
              "text": "$P(D=5)=2/36=1/18$."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "M1",
              "text": "The ordered outcomes are $(1,5),(5,1),(2,6),(6,2)$."
            },
            {
              "code": "A2",
              "text": "$P(D=4)=4/36=1/9$."
            }
          ]
        },
        {
          "part": "d",
          "steps": [
            {
              "code": "A1",
              "text": "$x=8$."
            },
            {
              "code": "A1",
              "text": "$y=4$ and $z=2$."
            }
          ]
        },
        {
          "part": "e",
          "steps": [
            {
              "code": "M1",
              "text": "Evaluate $\\sum dP(D=d)=[10+16+18+16+10]/36$."
            },
            {
              "code": "A1",
              "text": "$E(D)=35/18$."
            }
          ]
        },
        {
          "part": "f",
          "steps": [
            {
              "code": "M1",
              "text": "Use probabilities $2/36,10/36,24/36$."
            },
            {
              "code": "A1",
              "text": "$E(\\mathrm{profit})=7(2/36)+1(10/36)-L(24/36)$."
            },
            {
              "code": "M1",
              "text": "Fairness requires expectation 0."
            },
            {
              "code": "A1",
              "text": "$L=1$."
            }
          ]
        }
      ],
      "sourcePages": [
        9
