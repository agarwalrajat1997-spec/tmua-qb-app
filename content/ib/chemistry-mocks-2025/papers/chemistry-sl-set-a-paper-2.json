    {
      "title": "Reconciling rate and yield",
      "stem": "In a sealed vessel, 2SO₂(g)+O₂(g) ⇌ 2SO₃(g) is exothermic in the forward direction. At one temperature the equilibrium concentrations are 0.200, 0.100 and 0.400 mol dm⁻³ for SO₂, O₂ and SO₃ respectively. At the same temperature, the equilibrium constant for the reversed equation is 0.0250.",
      "parts": [
        {
          "label": "a",
          "prompt": "Write the equilibrium expression for the forward reaction. Use the reverse-reaction constant to determine the forward constant.",
          "marks": 3
        },
        {
          "label": "b",
          "prompt": "The vessel is compressed at constant temperature. Predict the equilibrium change in amount of SO₃ and the change, if any, in Kc.",
          "marks": 2
        },
        {
          "label": "c",
          "prompt": "Explain why a catalyst can increase hourly production in a flow reactor without changing the equilibrium yield in a sealed vessel.",
          "marks": 3
        },
        {
          "label": "d",
          "prompt": "A manager proposes increasing temperature to maximize both rate and equilibrium yield. Evaluate both parts of the proposal.",
          "marks": 2
        }
      ],
      "markScheme": [
        {
          "part": "a",
          "steps": [
            {
              "code": "B1",
              "text": "Kc=[SO₃]²/([SO₂]²[O₂])."
            },
            {
              "code": "B1",
              "text": "At fixed temperature, reversing the equation inverts the equilibrium expression: Kforward = 1/Kreverse. Also accept valid substitution of the supplied equilibrium concentrations."
            },
            {
              "code": "B1",
              "text": "Kc=40.0."
            }
          ]
        },
        {
          "part": "b",
          "steps": [
            {
              "code": "B1",
              "text": "Compression favours the side with fewer moles of gas (2 rather than 3), increasing amount of SO₃."
            },
            {
              "code": "B1",
              "text": "Kc remains unchanged at the same temperature."
            }
          ]
        },
        {
          "part": "c",
          "steps": [
            {
              "code": "B1",
              "text": "It provides an alternative pathway with lower activation energy."
            },
            {
              "code": "B1",
              "text": "It speeds both forward and reverse reactions and shortens the time needed to approach equilibrium."
            },
            {
              "code": "B1",
              "text": "It does not change equilibrium composition or K at fixed temperature."
            }
          ]
        },
        {
          "part": "d",
          "steps": [
            {
              "code": "B1",
              "text": "A larger fraction of collisions can overcome the activation barrier, generally increasing rate."
            },
            {
              "code": "B1",
              "text": "Higher temperature favours the endothermic reverse direction, reducing equilibrium yield of SO₃; the aims conflict."
            }
          ]
        }
      ],
      "marks": 10,
      "questionType": "structured",
      "answerSummary": "Higher temperature favours the endothermic reverse direction, reducing equilibrium yield of SO₃; the aims conflict.",
